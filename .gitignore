# ---------------------------------------------------------------
# Secrets and site-specific config: never commit.
# Commit only sanitized templates (*.example.*) with placeholders.
# ---------------------------------------------------------------
.env
.env.*
*.env
!*.example.env
!.env.example
*.ini
!*.example.ini
*.pem
*.key
*.crt
*.p12
secrets/
# Personal notes, deploy details, host inventories, etc.
local/
*.local
*.local.*

